class AddressInUseError(OSError): ...
class PacketError(ValueError): ...
class TCPStateError(ConnectionError): ...

class Engine:
    def __init__(self, ip_address: str, mtu: int, seed: int,
                 any_ip: bool = False) -> None: ...
    def intercept(self, packet: bytes, buffer_size: int, timestamp_us: int) -> int: ...
    def listen(self, port: int, backlog: int, buffer_size: int) -> int: ...
    def listener_accept(self, listener_id: int) -> int | None: ...
    def listener_close(self, listener_id: int) -> None: ...
    def connect(self, ip_address: str, port: int, local_port: int | None,
                buffer_size: int) -> int: ...
    def receive(self, packet: bytes) -> None: ...
    def advance(self, timestamp_us: int) -> None: ...
    def transmit(self) -> list[bytes]: ...
    def next_delay(self, timestamp_us: int) -> int | None: ...
    def connection_receive(self, connection_id: int,
                           maximum: int | None = None) -> bytes: ...
    def connection_send(self, connection_id: int, content: bytes) -> int: ...
    def connection_close(self, connection_id: int) -> None: ...
    def connection_abort(self, connection_id: int) -> None: ...
    def connection_release(self, connection_id: int) -> None: ...
    def shutdown(self) -> None: ...
    def connection_state(self, connection_id: int) -> str: ...
    def connection_endpoints(self, connection_id: int) -> tuple[tuple[str, int] | None,
                                                                 tuple[str, int] | None]: ...
    def connection_can_receive(self, connection_id: int) -> bool: ...
    def connection_can_send(self, connection_id: int) -> bool: ...
    def connection_eof(self, connection_id: int) -> bool: ...
    def connection_events(self) -> list[tuple[int, bool, bool, bool]]: ...
    def connection_count(self) -> int: ...
