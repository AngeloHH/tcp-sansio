from collections.abc import Callable

class TCPConnection:
    id: int
    @property
    def released(self) -> bool: ...
    @property
    def state(self) -> str: ...
    @property
    def local_address(self) -> tuple[str, int] | None: ...
    @property
    def remote_address(self) -> tuple[str, int] | None: ...
    @property
    def can_receive(self) -> bool: ...
    @property
    def can_send(self) -> bool: ...
    @property
    def eof(self) -> bool: ...
    def receive(self, maximum: int | None = None) -> bytes: ...
    def send(self, content: bytes) -> int: ...
    def close(self) -> None: ...
    def abort(self) -> None: ...
    def release(self) -> None: ...
    def __enter__(self) -> TCPConnection: ...
    def __exit__(self, *args) -> None: ...

class TCPEvent:
    connection: TCPConnection
    readable: bool
    writable: bool
    eof: bool

class TCPListener:
    id: int
    address: tuple[str, int]
    def accept(self) -> TCPConnection | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> TCPListener: ...
    def __exit__(self, *args) -> None: ...

class TCPStack:
    ip_address: str
    mtu: int
    any_ip: bool
    def __init__(self, ip_address: str, mtu: int = 1500,
                 seed: int | None = None,
                 clock: Callable[[], float] | None = ...,
                 any_ip: bool = False) -> None: ...
    def intercept(self, packet: bytes, timestamp: float | None = None,
                  buffer_size: int = 65535) -> TCPConnection: ...
    def listen(self, port: int, backlog: int = 16,
               buffer_size: int = 65535) -> TCPListener: ...
    def connect(self, ip_address: str, port: int, local_port: int | None = None,
                buffer_size: int = 65535) -> TCPConnection: ...
    def receive(self, packet: bytes, timestamp: float | None = None) -> None: ...
    def advance(self, timestamp: float | None = None) -> None: ...
    def transmit(self, timestamp: float | None = None) -> list[bytes]: ...
    def next_timeout(self, timestamp: float | None = None) -> float | None: ...
    def events(self) -> list[TCPEvent]: ...
    def close(self) -> list[bytes]: ...
    def __enter__(self) -> TCPStack: ...
    def __exit__(self, *args) -> None: ...
